{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "agent-unlock-capability",
  "description": "Minimum capability for the isolated VaultMesh MCP unlock window.",
  "windows": ["agent-unlock"],
  "local": true,
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "allow-agent-unlock-status",
    "allow-agent-unlock-set-scope",
    "allow-agent-unlock-password",
    "allow-agent-unlock-pin",
    "allow-agent-unlock-biometric",
    "allow-agent-unlock-cancel"
  ]
}

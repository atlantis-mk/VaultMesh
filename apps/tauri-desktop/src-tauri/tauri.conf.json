{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultMesh",
  "version": "0.0.10-review",
  "identifier": "com.vaultmesh.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VaultMesh",
        "width": 1180,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main-capability", "agent-pairing-capability", "agent-unlock-capability", "agent-authorization-capability"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icon.png",
      "../resources/icon.icns",
      "../resources/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "wix": {
        "upgradeCode": "54591767-50d9-5adc-879b-58465ad2719e",
        "version": "0.0.9",
        "fragmentPaths": ["./windows/browser-host.wxs"],
        "componentRefs": ["BrowserNativeMessagingRegistration"]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/browser-host-hooks.nsh"
      }
    }
  }
}

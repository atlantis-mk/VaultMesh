<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="52dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp">
    <ImageView android:layout_width="36dp" android:layout_height="36dp"
        android:src="@mipmap/ic_launcher_artwork" android:contentDescription="@null" />
    <TextView android:id="@android:id/text1" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:singleLine="true"
        android:ellipsize="end" android:textSize="16sp"
        android:textColor="@color/autofill_text_primary" />
    <ImageView android:layout_width="18dp" android:layout_height="18dp"
        android:layout_marginStart="8dp" android:src="@drawable/ic_autofill_chevron"
        android:contentDescription="@null" />
</LinearLayout>

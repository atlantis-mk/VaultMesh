{
  "name": "@vaultmesh/bitwarden-browser",
  "version": "0.0.10-review",
  "description": "VaultMesh browser extension prototype based on Bitwarden",
  "private": true,
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlantis-mk/VaultMesh.git",
    "directory": "apps/bitwarden-browser"
  },
  "scripts": {
    "identity:test": "node --test scripts/development-identity.test.mjs",
    "native:host:build": "cargo build -p vaultmesh-tauri-desktop --bin vaultmesh-bitwarden-dev-host",
    "native:host:plan": "node scripts/native-host.mjs",
    "native:host:install": "node scripts/native-host.mjs --install",
    "branding:sync": "node scripts/sync-vaultmesh-branding.mjs",
    "branding:test": "node --test scripts/vaultmesh-branding.test.mjs",
    "build": "npm run build:chrome",
    "build:chrome": "cross-env BROWSER=chrome MANIFEST_VERSION=3 NODE_OPTIONS=\"--max-old-space-size=8192\" webpack",
    "build:dev:chrome": "npm run build:chrome && npm run update:dev:chrome",
    "build:edge": "cross-env BROWSER=edge MANIFEST_VERSION=3 NODE_OPTIONS=\"--max-old-space-size=8192\" webpack",
    "build:firefox": "cross-env BROWSER=firefox NODE_OPTIONS=\"--max-old-space-size=8192\" webpack",
    "build:opera": "cross-env BROWSER=opera MANIFEST_VERSION=3 NODE_OPTIONS=\"--max-old-space-size=8192\" webpack",
    "build:safari": "cross-env BROWSER=safari NODE_OPTIONS=\"--max-old-space-size=8192\" webpack",
    "build:watch": "npm run build:watch:chrome",
    "build:watch:chrome": "npm run build:chrome -- --watch",
    "build:watch:edge": "npm run build:edge -- --watch",
    "build:watch:firefox": "npm run build:firefox -- --watch",
    "build:watch:opera": "npm run build:opera -- --watch",
    "build:watch:safari": "npm run build:safari -- --watch",
    "build:watch:firefox:mv3": "cross-env MANIFEST_VERSION=3 npm run build:watch:firefox",
    "build:watch:safari:mv3": "cross-env MANIFEST_VERSION=3 npm run build:watch:safari",
    "build:prod:chrome": "cross-env NODE_ENV=production npm run build:chrome",
    "build:prod:edge": "cross-env NODE_ENV=production npm run build:edge",
    "build:prod:firefox": "cross-env NODE_ENV=production npm run build:firefox",
    "build:prod:opera": "cross-env NODE_ENV=production npm run build:opera",
    "build:prod:safari": "cross-env NODE_ENV=production npm run build:safari",
    "build:beta:chrome": "cross-env CHANNEL=beta npm run build:prod:chrome",
    "dist:chrome": "npm run build:prod:chrome && mkdir -p dist && ./scripts/compress.sh dist-chrome.zip",
    "dist:beta:chrome": "npm run build:beta:chrome && npm run update:beta:chrome && mkdir -p dist && ./scripts/compress.sh dist-chrome.zip",
    "dist:edge": "npm run build:prod:edge && mkdir -p dist && ./scripts/compress.sh dist-edge.zip",
    "dist:firefox": "npm run build:prod:firefox && mkdir -p dist && ./scripts/compress.sh dist-firefox.zip",
    "dist:opera": "npm run build:prod:opera && mkdir -p dist && ./scripts/compress.sh dist-opera.zip",
    "dist:safari": "npm run build:prod:safari && ./scripts/package-safari.ps1",
    "dist:firefox:mv3": "cross-env MANIFEST_VERSION=3 npm run dist:firefox",
    "dist:opera:mv3": "cross-env MANIFEST_VERSION=3 npm run dist:opera",
    "dist:safari:mv3": "cross-env MANIFEST_VERSION=3 npm run dist:safari",
    "package:dev:chrome": "npm run update:dev:chrome && ./scripts/compress.sh dev-chrome.zip",
    "package:dev:beta:chrome": "npm run update:dev:chrome && ./scripts/compress.sh dev-chrome-beta.zip",
    "test": "jest",
    "test:popup-build": "node --test scripts/popup-render.test.mjs",
    "test:content-build": "node --test scripts/content-render.test.mjs",
    "test:adapter": "jest --runInBand src/vaultmesh src/platform/services/vaultmesh-browser-rpc.service.spec.ts src/background/vaultmesh-rpc.background.spec.ts src/autofill/services/autofill.service.spec.ts src/autofill/services/insert-autofill-content.service.spec.ts src/autofill/services/collect-autofill-content.service.spec.ts src/autofill/services/dom-element-visibility.service.spec.ts src/autofill/services/inline-menu-field-qualification.service.spec.ts",
    "test:watch": "jest --watch",
    "test:watch:all": "jest --watchAll",
    "test:clearCache": "jest --clear-cache",
    "update:dev:chrome": "node scripts/development-identity.mjs",
    "update:beta:chrome": "./scripts/update-manifest-beta.sh",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "dependencies:test": "node --test scripts/local-dependencies.test.mjs"
  },
  "dependencies": {
    "@angular/animations": "21.2.17",
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "@bitwarden/sdk-internal": "0.2.0-main.1015",
    "@bufbuild/protobuf": "2.13.0",
    "@emotion/css": "11.13.5",
    "@lit-labs/signals": "0.3.0",
    "@microsoft/signalr": "10.0.0",
    "@microsoft/signalr-protocol-msgpack": "10.0.0",
    "@ng-select/ng-select": "21.8.2",
    "@webcomponents/custom-elements": "1.6.0",
    "big-integer": "1.6.52",
    "buffer": "6.0.3",
    "core-js": "3.50.0",
    "jszip": "3.10.1",
    "lit": "3.3.1",
    "lunr": "2.3.9",
    "ngx-toastr": "19.1.0",
    "node-forge": "1.4.0",
    "oauth4webapi": "3.8.6",
    "papaparse": "5.5.3",
    "qrcode-parser": "2.1.3",
    "rxjs": "7.8.1",
    "semver": "7.7.3",
    "tabbable": "6.4.0",
    "tldts": "7.4.2",
    "zod": "4.3.6",
    "jsqr": "1.4.0",
    "zone.js": "0.15.1",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@angular/compiler-cli": "21.2.17",
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.29.2",
    "@ngtools/webpack": "21.2.9",
    "@tailwindcss/container-queries": "0.1.1",
    "@types/chrome": "0.1.28",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/jest": "30.0.0",
    "@types/lunr": "2.3.7",
    "@types/node": "22.20.1",
    "@types/node-forge": "1.3.14",
    "@types/papaparse": "5.5.2",
    "@types/semver": "7.7.1",
    "@types/zxcvbn": "4.4.5",
    "autoprefixer": "10.4.22",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.4",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.6",
    "jest": "30.3.0",
    "jest-diff": "30.3.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-mock-extended": "4.0.1",
    "jest-preset-angular": "17.0.0",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "path-browserify": "1.0.1",
    "postcss": "8.5.23",
    "postcss-import": "14.1.0",
    "postcss-loader": "8.2.1",
    "postcss-nested": "6.2.0",
    "pretty-format": "30.3.0",
    "process": "0.11.10",
    "resolve-url-loader": "5.0.0",
    "sass": "1.99.0",
    "sass-loader": "16.0.7",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.18",
    "terser-webpack-plugin": "5.5.0",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "type-fest": "2.19.0",
    "typescript": "5.9.3",
    "typescript-strict-plugin": "2.4.4",
    "url": "0.11.4",
    "util": "0.12.5",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": "~11"
  }
}

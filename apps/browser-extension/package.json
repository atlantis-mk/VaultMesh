    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@vaultmesh/ssh-command-parser": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",

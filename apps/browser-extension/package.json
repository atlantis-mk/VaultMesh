{
  "name": "@vaultmesh/browser-extension",
  "version": "0.0.10-review",
  "description": "VaultMesh Chrome MV3 and Firefox MV2 extension",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlantis-mk/VaultMesh.git",
    "directory": "apps/browser-extension"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
